# Jovyx Shorts Factory Configuration
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Storage paths (relative to backend or absolute)
STORAGE_DIR=storage
OUTPUT_DIR=storage/renders
EXPORT_DIR=storage/exports

# Video Defaults
DEFAULT_RESOLUTION=1080x1920
DEFAULT_FPS=60
DEFAULT_CLIP_DURATION=30
HIGHLIGHT_SENSITIVITY=0.35

# Hardware Acceleration: auto, nvenc, cpu
ENCODER_PREFERENCE=auto

# AI Provider for metadata generation: mock, openai, gemini
AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=

# YouTube Data API v3 OAuth 2.0
# Set these from your Google Cloud Console (OAuth 2.0 Web Client)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/publishing/youtube/callback
